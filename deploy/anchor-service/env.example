# Copy to .env and fill. Never commit the filled file.
# The process refuses to start if TOKENS or BASE_URL is missing.

CONARIUM_ANCHOR_TOKENS=./anchor.tokens.json
CONARIUM_ANCHOR_BASE_URL=https://anchor.example.invalid
CONARIUM_ANCHOR_STORE=./anchor-store.jsonl
CONARIUM_ANCHOR_HOST=127.0.0.1
CONARIUM_ANCHOR_PORT=8797
CONARIUM_ANCHOR_RATE=60
# 0 disables the background Bitcoin-upgrade pass (use for dry-run).
CONARIUM_ANCHOR_UPGRADE_MINUTES=60
