node_modules/
dist/
*.env
.env*
nexus.config.json
*.local.json

# Vercel proje baglantisi. Bu repo Vercel'e DEPLOY EDILMIYOR — conarium.dev
# ayri bir repodan (nexus) yayinlaniyor. Buradaki .vercel/ ayni Vercel
# projesine isaret ediyordu; bu dizinden calisan bir "vercel --prod" sitenin
# ana sayfasini silerdi (bu repoda index.html yok). Baglanti bilerek kaldirildi.
.vercel/

# session debris / sensitive (güvenlik denetimi 2026-06-29)
*_dump.json
telegram_dump.json
temp_*.py
*.tmp
audit.log.jsonl
src/scripts/*.py

# NEO red-team çıktısı
redteam/last-report.md

# internal / junk
telegram_dump.json
ZION_NOTES.md
*.log.jsonl
# Audit sink advisory lock: runtime state (pid + start), never committed.
*.jsonl.lock
temp_*.py
test_ast*.ts
conarium-i18n-*.js
i18n_assessment.js

# next.js build junk / stray scaffolding
site/
.next/
*.tsbuildinfo
.gstack/

# internal review artifacts (never publish)
neo-review-findings.json
src/neo-council-findings.json
console-run.log

# Dogrucan-ozel deployment (public repoya girmez; ozel yedek: Obsidian vault)
conarium-audit-*.jsonl*
conarium.config.c*.json
AGENTS.md
PROJECT_CONTEXT.md

examples/demo-bank/_keys/
examples/demo-bank/*.jsonl
examples/per-user-identity/conarium.tokens.json
# 2026-07-31'de yakalandi: bir ajan calisma sirasinda tmp-test/test-key.pem
# (Ed25519 ozel anahtari) uretti ve burasi PUBLIC repo; hicbir desen onu
# kapsamiyordu, "git add ." demek yeterdi. Uretilen anahtar test bile olsa
# ozel anahtarin public repoda isi yok.
*.pem
*.key
*.pfx
*.p12
*.keystore
*.jks
*.pem.keyid
# Acik anahtarlar guvenli ve testlerin ihtiyaci — istisna.
!*.pub.pem
!test/fixtures/**/pubkey.pem
# Konformans vektorlerinin ACIK anahtari ve keyId yan dosyasi yayimlanmali:
# dogrulayici keyId sidecar'i olmadan exit 13 verir, yani bu satir olmadan
# TAZE KLONDA butun vektorler kirik gelir. (Ozel anahtar yukaridaki *.pem
# kuralinda kaliyor ve BILEREK yayimlanmiyor — bkz test-vectors/README.md.)
!test-vectors/keys/*.pub.pem
!test-vectors/keys/*.pub.pem.keyid

# npm pack ciktisi — paketleme artefakti, repoya girmez
*.tgz

# Python bytecode: deploy/hetzner altindaki ops betiklerine `py_compile` ile
# sozdizimi kontrolu yapinca uretiliyor. 08-13'te `git add deploy/hetzner`
# bunlari da supurup commit'ledi — uretilmis dosya repoya girmez.
__pycache__/
*.pyc

# Canli kurulumun (Hetzner /opt/conarium-mcp) calisma dizininde biriken dosyalar.
# Bu dizin bir git checkout'u ve burasi PUBLIC repo. 2026-08-13'te olculdu:
# .mcp_token hicbir desene girmiyordu — orada "git add ." diyen biri TOKEN'i
# public repoya sokardi. Ayni sinif olay 07-31'de ozel anahtarla yasandi.
# audit/ makbuz ve denetim zinciri: musteri verisinin izini tasir, asla commit'lenmez.
.mcp_token
audit/
DURUM.md
.demo_keepalive_state
.demo_watch_state
# Elle alinmis config yedekleri: canli DSN/token tasiyabilir, kopya oldugu icin
# kimse icerigini gozden gecirmez. (08-13'te iki tane duruyordu.)
*.yedek-*
