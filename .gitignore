# Vercel proje baglantisi. Bu repo Vercel'e DEPLOY EDILMIYOR — conarium.dev
# ayri bir repodan (nexus) yayinlaniyor. Buradaki .vercel/ ayni Vercel
# projesine isaret ediyordu; bu dizinden calisan bir "vercel --prod" sitenin
# ana sayfasini silerdi (bu repoda index.html yok). Baglanti bilerek kaldirildi.
.vercel/

# session debris / sensitive (güvenlik denetimi 2026-06-29)
*_dump.json
telegram_dump.json
temp_*.py
*.tmp
audit.log.jsonl
audit.test.jsonl
audit.log.jsonl.legacy-*
src/scripts/*.py

# NEO red-team çıktısı
redteam/last-report.md

# internal / junk
telegram_dump.json
ZION_NOTES.md
*.log.jsonl
# Audit sink advisory lock: runtime state (pid + start), never committed.
*.jsonl.lock
temp_*.py
